<footer class="cisc-footer">
  <div class="cisc-container cisc-footer__grid">
    <div class="cisc-footer__logo">
      <img
        src="/wp-content/uploads/2020/10/cisc-logo-full.png"
        alt="Center Industrial Supply Corporation"
        width="256"
        height="50"
      />
      <p>
        Leading distributor of welding and cutting equipment, consumables, and automation
        solutions for Philippine industries.
      </p>
    </div>
    <div>
      <h3>Quick Links</h3>
      <ul class="cisc-footer__links">
        <li><a href="/about-us/">About Us</a></li>
        <li><a href="/products/">Products</a></li>
        <li><a href="/all-products/">Product Catalog</a></li>
        <li><a href="/support/">Support &amp; Service</a></li>
        <li><a href="/contact-us/">Contact</a></li>
      </ul>
      <ul class="cisc-footer__social">
        {
          socialLinks.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                <span class="cisc-sr-only">{link.name}</span>
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={link.path} />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h3>Head Office</h3>
      <ul class="cisc-footer__links">
        <li>10 South AA Street, Quezon City<br />Metro Manila, Philippines 1103</li>
        <li><a href="tel:+63283739651">(02) 8373-9651</a></li>
        <li><a href="tel:+63234168688">(02) 3416-8688</a></li>
        <li><a href="mailto:info@centerindustrial.com">info@centerindustrial.com</a></li>
        <li>Mon–Fri: 7:30 AM – 5:30 PM</li>
      </ul>
    </div>
  </div>
  <div class="cisc-footer__bottom">
    <div class="cisc-container">&copy; 2026 Center Industrial Supply Corporation. All rights reserved.</div>
  </div>
</footer>
